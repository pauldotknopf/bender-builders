@model BenderBuilders.Interfaces.Dtos.ProposalDto

<form asp-controller="Proposals" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CustomerName" class="form-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ProposalDate" class="form-label"></label>
            <input asp-for="ProposalDate" class="form-control" />
            <span asp-validation-for="ProposalDate" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Address1" class="form-label"></label>
            <input asp-for="Address1" class="form-control" />
            <span asp-validation-for="Address1" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Address2" class="form-label"></label>
            <input asp-for="Address2" class="form-control" />
            <span asp-validation-for="Address2" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
            <span asp-validation-for="State" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="JobLocation" class="form-label"></label>
            <input asp-for="JobLocation" class="form-control" />
            <span asp-validation-for="JobLocation" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FedIdNumber" class="form-label"></label>
            <input asp-for="FedIdNumber" class="form-control" />
            <span asp-validation-for="FedIdNumber" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="ProposalSummary" class="form-label"></label>
            <textarea asp-for="ProposalSummary" class="form-control" rows="4"></textarea>
            <span asp-validation-for="ProposalSummary" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-controller="Proposals" asp-action="Index">Back</a>
    </div>
</form>
