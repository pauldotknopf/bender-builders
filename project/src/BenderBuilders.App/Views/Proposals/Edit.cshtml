@model BenderBuilders.Interfaces.Dtos.ProposalDto
@{
    ViewData["Title"] = "Edit proposal";
}

<h1 class="h3 mb-3">Edit proposal</h1>

<partial name="_ProposalForm" model="Model" />

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Invoices</span>
        <button type="button" class="btn btn-sm btn-outline-primary" disabled>Add invoice</button>
    </div>
    <div class="card-body text-muted">
        Invoice management is coming soon.
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-controller="Proposals" asp-action="GeneratePdf" asp-route-id="@Model.Id">Save as PDF</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
