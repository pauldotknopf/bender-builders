@model BenderBuilders.App.Models.ProposalEditViewModel
@{
    ViewData["Title"] = "Edit proposal";
}

<h1 class="h3 mb-3">Edit proposal</h1>

<partial name="_ProposalForm" model="Model.Proposal" />

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Invoices</span>
        <a class="btn btn-sm btn-primary" asp-controller="Invoices" asp-action="Create" asp-route-proposalId="@Model.Proposal.Id">Add invoice</a>
    </div>
    <div class="card-body">
        @if (!Model.Invoices.Any())
        {
            <p class="text-muted mb-0">No invoices yet &mdash; <a asp-controller="Invoices" asp-action="Create" asp-route-proposalId="@Model.Proposal.Id">add your first one</a>.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Invoice Date</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var summary in Model.Invoices)
                        {
                            <tr>
                                <td>@summary.Invoice.InvoiceDate.ToString("d")</td>
                                <td class="text-end">@summary.Total.ToString("C")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Invoices" asp-action="GeneratePdf" asp-route-id="@summary.Invoice.Id">Save as PDF</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Invoices" asp-action="Edit" asp-route-id="@summary.Invoice.Id">Edit</a>
                                    <form class="d-inline" asp-controller="Invoices" asp-action="Delete" asp-route-id="@summary.Invoice.Id" method="post" onsubmit="return confirm('Delete this invoice?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a class="btn btn-outline-primary" asp-controller="Proposals" asp-action="GeneratePdf" asp-route-id="@Model.Proposal.Id">Save as PDF</a>
    @if (Model.Proposal.Id > 0)
    {
        <form class="d-inline" asp-controller="Proposals" asp-action="Delete" asp-route-id="@Model.Proposal.Id" method="post" onsubmit="return confirm('Delete this proposal? This will also delete all of its invoices.');">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
