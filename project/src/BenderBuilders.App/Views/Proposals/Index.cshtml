@model IReadOnlyList<BenderBuilders.Interfaces.Dtos.ProposalDto>
@{
    ViewData["Title"] = "Proposals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Proposals</h1>
    <div>
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Back</button>
        <a class="btn btn-primary" asp-controller="Proposals" asp-action="Create">Create a proposal</a>
    </div>
</div>

@await Html.PartialAsync("_ProposalsTable", Model)
