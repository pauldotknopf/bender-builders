@model BenderBuilders.App.Models.InvoiceFormViewModel
@{
    ViewData["Title"] = "Edit invoice";
}

<h1 class="h3 mb-3">Edit invoice @(Model.Proposal is not null ? $"for {Model.Proposal.CustomerName}" : string.Empty)</h1>

<partial name="_InvoiceForm" model="Model" />

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-controller="Invoices" asp-action="GeneratePdf" asp-route-id="@Model.Invoice.Id">Save as PDF</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_LineItemScripts" />
}
