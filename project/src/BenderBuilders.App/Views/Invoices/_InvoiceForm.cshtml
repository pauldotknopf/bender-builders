@model BenderBuilders.App.Models.InvoiceFormViewModel

<form asp-controller="Invoices" asp-action="@(Model.Invoice.Id == 0 ? "Create" : "Edit")" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Invoice.Id" />
    <input type="hidden" asp-for="Invoice.ProposalId" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Invoice.InvoiceDate" class="form-label"></label>
            <input asp-for="Invoice.InvoiceDate" class="form-control" />
            <span asp-validation-for="Invoice.InvoiceDate" class="text-danger"></span>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Line items</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addLineItem">Add line item</button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Description</th>
                            <th scope="col" class="col-md-3">Amount</th>
                            <th scope="col" class="text-end col-md-1"></th>
                        </tr>
                    </thead>
                    <tbody id="lineItemsBody">
                        @for (var i = 0; i < Model.LineItems.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="LineItems[i].Id" />
                                    <input asp-for="LineItems[i].Description" class="form-control" placeholder="Description" />
                                    <span asp-validation-for="LineItems[i].Description" class="text-danger"></span>
                                </td>
                                <td>
                                    <input asp-for="LineItems[i].Amount" type="number" step="0.01" class="form-control text-end" placeholder="0.00" />
                                    <span asp-validation-for="LineItems[i].Amount" class="text-danger"></span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-line-item-remove>Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <th scope="row">Total</th>
                            <td class="text-end" id="lineItemsTotal">@Model.LineItems.Sum(x => x.Amount).ToString("C")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-controller="Proposals" asp-action="Edit" asp-route-id="@Model.Invoice.ProposalId">Back</a>
    </div>
</form>
